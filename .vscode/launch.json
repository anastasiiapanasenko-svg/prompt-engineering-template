{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug recipe API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/recipe-app-backend/src/index.ts",
      "runtimeArgs": ["--import", "tsx", "--inspect"],
      "cwd": "${workspaceFolder}/recipe-app-backend",
      "envFile": "${workspaceFolder}/recipe-app-backend/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
